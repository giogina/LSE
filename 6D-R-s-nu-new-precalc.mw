<Group hide-input="false" hide-output="false" labelreference="L1" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">restart:
with(GiosTools):
with(LinearAlgebra):

proc (phi) options operator, arrow; 
(-(1/2)*(diff(diff(phi, r14), r14))+(1/2)*(r12^2-r14^2-r24^2)*(diff(diff(phi, r14), r24))/(r14*r24)+(1/2)*(r13^2-r14^2-r34^2)*(diff(diff(phi, r14), r34))/(r14*r34)-(1/2)*(diff(diff(phi, r24), r24))+(1/2)*(r23^2-r24^2-r34^2)*(diff(diff(phi, r24), r34))/(r24*r34)-(1/2)*(diff(diff(phi, r34), r34))-(diff(phi, r14))/r14-(diff(phi, r24))/r24-(diff(phi, r34))/r34)/m4+(-(1/2)*(diff(diff(phi, r13), r13))+(1/2)*(r12^2-r13^2-r23^2)*(diff(diff(phi, r13), r23))/(r23*r13)-(1/2)*(r13^2-r14^2+r34^2)*(diff(diff(phi, r13), r34))/(r34*r13)-(1/2)*(diff(diff(phi, r23), r23))-(1/2)*(r23^2-r24^2+r34^2)*(diff(diff(phi, r23), r34))/(r34*r23)-(1/2)*(diff(diff(phi, r34), r34))-(diff(phi, r13))/r13-(diff(phi, r23))/r23-(diff(phi, r34))/r34)/m3+(-(1/2)*(diff(diff(phi, r12), r12))-(1/2)*(r12^2-r13^2+r23^2)*(diff(diff(phi, r12), r23))/(r23*r12)-(1/2)*(r12^2-r14^2+r24^2)*(diff(diff(phi, r12), r24))/(r12*r24)-(1/2)*(diff(diff(phi, r23), r23))-(1/2)*(r23^2+r24^2-r34^2)*(diff(diff(phi, r23), r24))/(r23*r24)-(1/2)*(diff(diff(phi, r24), r24))-(diff(phi, r12))/r12-(diff(phi, r23))/r23-(diff(phi, r24))/r24)/m2+(-(1/2)*(diff(diff(phi, r12), r12))-(1/2)*(r12^2+r13^2-r23^2)*(diff(diff(phi, r12), r13))/(r12*r13)-(1/2)*(r12^2+r14^2-r24^2)*(diff(diff(phi, r12), r14))/(r14*r12)-(1/2)*(diff(diff(phi, r13), r13))-(1/2)*(r13^2+r14^2-r34^2)*(diff(diff(phi, r13), r14))/(r14*r13)-(1/2)*(diff(diff(phi, r14), r14))-(diff(phi, r12))/r12-(diff(phi, r13))/r13-(diff(phi, r14))/r14)/m1
end proc:

unapply(subs([r34 = rAB, r14 = rA1, r13 = rB1, r23 = rB2, r24 = rA2], subs(phi(r12, r23, r34, r13, r24, r14) = phi,
eval(%(phi(r12, r23, r34, r13, r24, r14)), [m1=1, m2=1, m3=M, m4=M]))), phi):
T1234:=%:

Vop := (1/rAB+1/r12-1/rA1-1/rA2-1/rB1-1/rB2):
TAB12M := unapply(subs(phi(rAB, rA1, rA2, rB1, rB2, r12)=phi, eval(T1234(phi(rAB, rA1, rA2, rB1, rB2, r12)), [M=M])), phi);

Digits:=30;

</Text-field>
</Input>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display=""></Equation></Text-field>
</Output>
<Output><Text-field style="2D Output" layout="Maple Output"><Equation executable="false" style="2D Output" display="">IiNJ</Equation></Text-field>
</Output>
