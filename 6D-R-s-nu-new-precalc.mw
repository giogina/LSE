<Group hide-input="false" hide-output="false" labelreference="L4544" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal">subs({
r12^2-rA1^2-rA2^2 = -(cos1A2)*rA1*rA2*2,
-rA1^2-rAB^2+rB1^2 = -cos1AB*rA1*rAB*2,
-rA2^2-rAB^2+rB2^2 = -cos2AB*rA2*rAB*2,
r12^2-rB1^2-rB2^2 = -cos1B2*rB1*rB2*2,
-rA1^2+rAB^2+rB1^2 = cos1BA*rAB*rB1*2,
-rA2^2+rAB^2+rB2^2 = cos2BA*rAB*rB2*2,
r12^2-rB1^2+rB2^2 = cos12B*rB2*r12*2,
r12^2-rA1^2+rA2^2 = cos12A*r12*rA2*2,
rA2^2-rAB^2+rB2^2 = cosA2B*rB2*rA2*2,
r12^2+rB1^2-rB2^2 = cos21B*r12*rB1*2,
r12^2+rA1^2-rA2^2 = cos21A*rA1*r12*2,
rA1^2-rAB^2+rB1^2 = cosA1B*rA1*rB1*2

}, # [cos1A2, ]

TAB12M(phi(rAB, rA1, rA2, rB1, rB2, r12))):
collect(eval(collect(%, [diff, phi], factor@simplify), M+1=N*M), [N, M]):
cosT:=unapply(subs(phi(rAB, rA1, rA2, rB1, rB2, r12)=phi, %), phi);

nops(%%);


</Text-field>
